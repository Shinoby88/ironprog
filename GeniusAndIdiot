using System;

namespace ConsoleApp271
{
    internal class Program
    {
        static string[] questions;
        static int[] answers;
        static Random random = new Random();

        static void Main(string[] args)
        {
            InitializeData();
            string repeatTest = string.Empty;

            while (repeatTest != "no")
            {
                Shuffle();

                int correctAnswerCount = 0;
                int numberQuestionsCount = 0;
                Console.Write("Доброго времени суток. Введите ваше имя = ");
                string userName = Console.ReadLine();

                for (int i = 0; i < questions.Length; i++)
                {
                    numberQuestionsCount++;
                    Console.WriteLine($"Номер вопроса {numberQuestionsCount}");
                    Console.WriteLine(questions[i]);
                    Console.Write("Ваш ответ = ");
                    string userAnswer = Console.ReadLine();

                    if (int.TryParse(userAnswer, out int digitUserAnsver))
                    {
                        Console.WriteLine($"{digitUserAnsver}");
                    }
                    else
                    {
                        Console.WriteLine("Вы ввели НЕ число (буквы или символы)");
                    }
                    Console.WriteLine();

                    if (userAnswer == answers[i])
                    {
                        correctAnswerCount++;
                    }
                }

                string userDiagnosis = GetDiagnosis(correctAnswerCount);
                Console.WriteLine($"Количество правильных ответов = {correctAnswerCount}");
                Console.WriteLine($"Поздравляю {userName}, ваш диагноз {GetDiagnosis(correctAnswerCount)}");
                Console.Write("Желаете ли пройти еще раз? yes или no? ");
                repeatTest = Console.ReadLine();
            }
        }

        static void InitializeData()
        {
            questions = new string[5];
            questions[0] = "Сколько будет 2 плюс 2 умноженное на 2 (2+2*2)?";
            questions[1] = "Бревно нужно распилить на десять частей. Сколько надо сделать распилов?";
            questions[2] = "На двух руках 10 пальцев. Сколько пальцев на 5 руках?";
            questions[3] = "Укол делается каждые полчаса. Сколько нужно минут для трех уколов?";
            questions[4] = "Пять свечей горело, две потухли. Сколько свечей осталось?";

            answers = new int[5];
            answers[0] = 6;
            answers[1] = 9;
            answers[2] = 25;
            answers[3] = 60;
            answers[4] = 2;
        }

        static string GetDiagnosis(int correctAnswerCount)
        {
            if (correctAnswerCount == 5)
                return "Гений";
            if (correctAnswerCount == 4)
                return "Талант";
            if (correctAnswerCount == 3)
                return "Нормальный";
            if (correctAnswerCount == 2)
                return "Дурак";
            if (correctAnswerCount == 1)
                return "Кретин";
            return "Идиот";
        }

        static void Shuffle()
        {
            for (int i = 0; i < questions.Length; i++)
            {
                int j = random.Next(i, questions.Length);

                (questions[i], questions[j]) = (questions[j], questions[i]);
                (answers[i], answers[j]) = (answers[j], answers[i]);

            }
        }
    }
}
