### 6.2. Код
```csharp
using System;
using System.Windows.Forms;

namespace TestAppWinForms
{
    public partial class ResultsForm : Form
    {
        public ResultsForm(string resultFile)
        {
            InitializeComponent();
            LoadResults(resultFile);
        }

        private void LoadResults(string resultFile)
        {
            if (!System.IO.File.Exists(resultFile))
            {
                listBoxResults.Items.Add("Результатов пока нет!");
                return;
            }

            string[] lines = System.IO.File.ReadAllLines(resultFile);
            
            listBoxResults.Items.Add("========== РЕЗУЛЬТАТЫ ==========");
            listBoxResults.Items.Add($"{"ФИО",-20} | {"Правильных ответов",-10} | {"Диагноз",-15}");
            listBoxResults.Items.Add(new string('=', 60));

            foreach (string line in lines)
            {
                string[] parts = line.Split('|');
                if (parts.Length == 3)
                {
                    string formattedLine = $"{parts[0].Trim(),-20} | {parts[1].Trim(),-10} | {parts[2].Trim(),-15}";
                    listBoxResults.Items.Add(formattedLine);
                }
            }
            
            listBoxResults.Items.Add(new string('=', 60));
        }

        private void btnClose_Click(object sender, EventArgs e)
        {
            Close();
        }
    }
}
```

