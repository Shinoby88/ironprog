### 4.2. Код формы
```csharp
using System;
using System.Collections.Generic;
using System.Windows.Forms;

namespace TestAppWinForms
{
    public partial class TestForm : Form
    {
        private List<Question> questions;
        private Random random;
        private List<Question> shuffledQuestions;
        private int currentQuestionIndex = 0;
        private int correctCount = 0;
        private string userName;

        public TestForm(List<Question> questions, Random random)
        {
            InitializeComponent();
            this.questions = questions;
            this.random = random;
            
            // Перемешиваем вопросы
            shuffledQuestions = new List<Question>(questions);
            for (int i = 0; i < shuffledQuestions.Count - 1; i++)
            {
                int j = random.Next(i + 1, shuffledQuestions.Count);
                Question temp = shuffledQuestions[i];
                shuffledQuestions[i] = shuffledQuestions[j];
                shuffledQuestions[j] = temp;
            }

            AskUserName();
        }

        private void AskUserName()
        {
            // Спрашиваем имя пользователя
            using (var form = new Form())
            {
                form.Text = "Введите имя";
                form.Size = new System.Drawing.Size(300, 150);
                form.FormBorderStyle = FormBorderStyle.FixedDialog;
                form.StartPosition = FormStartPosition.CenterParent;

                Label label = new Label() { Text = "Введите ваше имя:", Left = 20, Top = 20, Width = 200 };
                TextBox textBox = new TextBox() { Left = 20, Top = 45, Width = 240 };
                Button buttonOk = new Button() { Text = "OK", Left = 180, Top = 75, Width = 80, DialogResult = DialogResult.OK };

                form.Controls.Add(label);
                form.Controls.Add(textBox);
                form.Controls.Add(buttonOk);

                if (form.ShowDialog() == DialogResult.OK && !string.IsNullOrEmpty(textBox.Text))
                {
                    userName = textBox.Text;
                    ShowQuestion();
                }
                else
                {
                    this.Close();
                }
            }
        }

        private void ShowQuestion()
        {
            if (currentQuestionIndex < shuffledQuestions.Count)
            {
                lblQuestionNumber.Text = $"Вопрос {currentQuestionIndex + 1} из {shuffledQuestions.Count}";
                lblQuestionText.Text = shuffledQuestions[currentQuestionIndex].Text;
                txtAnswer.Text = "";
                txtAnswer.Focus();
                lblResult.Text = $"Правильных ответов: {correctCount} из {shuffledQuestions.Count}";
            }
            else
            {
                ShowResults();
            }
        }

        private void btnAnswer_Click(object sender, EventArgs e)
        {
            // Проверяем ввод
            if (!int.TryParse(txtAnswer.Text, out int userAnswer))
            {
                MessageBox.Show("Пожалуйста, введите число!", "Ошибка", 
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                txtAnswer.Text = "";
                txtAnswer.Focus();
                return;
            }

            // Проверяем правильность
            if (userAnswer == shuffledQuestions[currentQuestionIndex].Answer)
            {
                correctCount++;
                MessageBox.Show("✅ Правильно!", "Отлично", 
                    MessageBoxButtons.OK, MessageBoxIcon.Information);
            }
            else
            {
                MessageBox.Show($"❌ Неправильно. Правильный ответ: {shuffledQuestions[currentQuestionIndex].Answer}", 
                    "Ошибка", MessageBoxButtons.OK, MessageBoxIcon.Warning);
            }

            // Переходим к следующему вопросу
            currentQuestionIndex++;
            ShowQuestion();
        }

        private void ShowResults()
        {
            string diagnosis = GetDiagnosis(correctCount, shuffledQuestions.Count);
            
            string message = $"Количество правильных ответов: {correctCount} из {shuffledQuestions.Count}\n" +
                           $"Поздравляю {userName}, ваш диагноз: {diagnosis}";

            MessageBox.Show(message, "Результаты теста", 
                MessageBoxButtons.OK, MessageBoxIcon.Information);

            // Сохраняем результат
            SaveResult(userName, correctCount, diagnosis);
            
            this.Close();
        }

        private string GetDiagnosis(int correctCount, int totalQuestions)
        {
            int percent = (correctCount * 100) / totalQuestions;

            if (percent == 100) return "Гений";
            if (percent >= 80) return "Талант";
            if (percent >= 60) return "Нормальный";
            if (percent >= 40) return "Дурак";
            if (percent >= 20) return "Кретин";
            return "Идиот";
        }

        private void SaveResult(string name, int correctCount, string diagnosis)
        {
            string line = $"{name} | {correctCount} | {diagnosis}";
            using (System.IO.StreamWriter writer = new System.IO.StreamWriter("results.txt", true))
            {
                writer.WriteLine(line);
            }
        }
    }
}
```

