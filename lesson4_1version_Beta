### 3.2. Код главной формы
```csharp
using System;
using System.Collections.Generic;
using System.Windows.Forms;

namespace TestAppWinForms
{
    public partial class Form1 : Form
    {
        // Это наши глобальные переменные (как в консольном приложении)
        private static List<Question> questions = new List<Question>();
        private static Random random = new Random();
        private static string resultFile = "results.txt";
        private static string questionFile = "questions.txt";

        public Form1()
        {
            InitializeComponent();
            LoadQuestions(); // Загружаем вопросы при запуске
        }

        // КНОПКА "Пройти тест"
        private void btnStartTest_Click(object sender, EventArgs e)
        {
            if (questions.Count == 0)
            {
                MessageBox.Show("Нет вопросов для тестирования!", "Ошибка", 
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            // Открываем форму теста
            TestForm testForm = new TestForm(questions, random);
            testForm.ShowDialog();
        }

        // КНОПКА "Добавить вопрос"
        private void btnAddQuestion_Click(object sender, EventArgs e)
        {
            AddQuestionForm addForm = new AddQuestionForm();
            if (addForm.ShowDialog() == DialogResult.OK)
            {
                // Добавляем новый вопрос
                questions.Add(new Question(addForm.QuestionText, addForm.Answer));
                SaveQuestionsToFile();
                MessageBox.Show("Вопрос успешно добавлен!", "Успех", 
                    MessageBoxButtons.OK, MessageBoxIcon.Information);
            }
        }

        // КНОПКА "Посмотреть результаты"
        private void btnShowResults_Click(object sender, EventArgs e)
        {
            ResultsForm resultsForm = new ResultsForm(resultFile);
            resultsForm.ShowDialog();
        }

        // КНОПКА "Удалить вопрос"
        private void btnDeleteQuestion_Click(object sender, EventArgs e)
        {
            if (questions.Count == 0)
            {
                MessageBox.Show("Нет вопросов для удаления!", "Ошибка", 
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            DeleteQuestionForm deleteForm = new DeleteQuestionForm(questions);
            if (deleteForm.ShowDialog() == DialogResult.OK)
            {
                // Удаляем вопрос
                int index = deleteForm.SelectedIndex;
                questions.RemoveAt(index);
                SaveQuestionsToFile();
                MessageBox.Show("Вопрос успешно удален!", "Успех", 
                    MessageBoxButtons.OK, MessageBoxIcon.Information);
            }
        }

        // КНОПКА "Выход"
        private void btnExit_Click(object sender, EventArgs e)
        {
            Application.Exit();
        }

        // МЕТОДЫ для работы с файлами (как в консольном приложении)
        private void LoadQuestions()
        {
            if (System.IO.File.Exists(questionFile))
            {
                string[] lines = System.IO.File.ReadAllLines(questionFile);
                foreach (string line in lines)
                {
                    string[] parts = line.Split('|');
                    if (parts.Length == 2 && int.TryParse(parts[1], out int answer))
                    {
                        questions.Add(new Question(parts[0], answer));
                    }
                }
            }

            // Если вопросов нет - создаем начальные
            if (questions.Count == 0)
            {
                InitializeDefaultQuestions();
                SaveQuestionsToFile();
            }
        }

        private void InitializeDefaultQuestions()
        {
            questions.Add(new Question("Сколько будет 2 плюс 2 умноженное на 2 (2+2*2)?", 6));
            questions.Add(new Question("Бревно нужно распилить на десять частей. Сколько надо сделать распилов?", 9));
            questions.Add(new Question("На двух руках 10 пальцев. Сколько пальцев на 5 руках?", 25));
            questions.Add(new Question("Укол делается каждые полчаса. Сколько нужно минут для трех уколов?", 60));
            questions.Add(new Question("Пять свечей горело, две потухли. Сколько свечей осталось?", 2));
        }

        private void SaveQuestionsToFile()
        {
            using (System.IO.StreamWriter writer = new System.IO.StreamWriter(questionFile))
            {
                foreach (Question q in questions)
                {
                    writer.WriteLine($"{q.Text}|{q.Answer}");
                }
            }
        }
    }
}
```

