using System;
using System.IO;

namespace ConsoleApp271
{
    internal class Program
    {
        static string[] questions;
        static int[] answers;
        static Random random = new Random();
        static string resultFile = "results.txt";

        static void Main(string[] args)
        {
            InitializeData();
            string repeatTest = string.Empty;

            while (repeatTest != "no")
            {
                Shuffle();

                int correctAnswerCount = 0;
                int numberQuestionsCount = 0;
                Console.Write("Доброго времени суток. Введите ваше имя = ");
                string userName = Console.ReadLine();

                for (int i = 0; i < questions.Length; i++)
                {
                    numberQuestionsCount++;
                    Console.WriteLine($"Номер вопроса {numberQuestionsCount}");
                    Console.WriteLine(questions[i]);
                    bool isValidInput= false;

                    while (!isValidInput)
                    {
                        Console.Write("Ваш ответ = ");
                        string userAnswer = Console.ReadLine();

                        if (int.TryParse(userAnswer, out int digitUserAnswer))
                        {
                            isValidInput = true;

                            if (digitUserAnswer == answers[i])
                            {
                                correctAnswerCount++;                             
                            }

                        }
                        else
                        {
                            Console.WriteLine("Вы ввели НЕ число (буквы или символы)");
                        }

                        Console.WriteLine();
                    }                    
                }

                string diagnosis = GetDiagnosis(correctAnswerCount, questions.Length);
                Console.WriteLine($"Количество правильных ответов = {correctAnswerCount}");
                Console.WriteLine($"Поздравляю {userName}, ваш диагноз {GetDiagnosis(correctAnswerCount, questions.Length)}");

                SaveResult(userName, correctAnswerCount, diagnosis);
                Console.Write("Желаете ли пройти еще раз? yes или no? ");
                repeatTest = Console.ReadLine();
            }

            ShowAllResults();
        }

        static void InitializeData()
        {
            questions = new string[5];
            questions[0] = "Сколько будет 2 плюс 2 умноженное на 2 (2+2*2)?";
            questions[1] = "Бревно нужно распилить на десять частей. Сколько надо сделать распилов?";
            questions[2] = "На двух руках 10 пальцев. Сколько пальцев на 5 руках?";
            questions[3] = "Укол делается каждые полчаса. Сколько нужно минут для трех уколов?";
            questions[4] = "Пять свечей горело, две потухли. Сколько свечей осталось?";

            answers = new int[5];
            answers[0] = 6;
            answers[1] = 9;
            answers[2] = 25;
            answers[3] = 60;
            answers[4] = 2;
        }

        static string GetDiagnosis(int correctAnswerCount, int totalQuestions)
        {
            var percent = (correctAnswerCount*100) / totalQuestions;

            if (percent == 100)
                return "Гений";
            if (percent >= 80)
                return "Талант";
            if (percent >= 60)
                return "Нормальный";
            if (percent >= 40)
                return "Дурак";
            if (percent >= 20)
                return "Кретин";
            return "Идиот";
        }

        static void Shuffle()
        {
            for (int i = 0; i < questions.Length; i++)
            {
                int j = random.Next(i, questions.Length);

                (questions[i], questions[j]) = (questions[j], questions[i]);
                (answers[i], answers[j]) = (answers[j], answers[i]);
            }
        }

        static void SaveResult(string name, int correctCount, string diagnosis)
        {
            string line = $"{name} | {correctCount} | {diagnosis}";
            using (StreamWriter writer = new StreamWriter(resultFile, true))
            {
                writer.WriteLine(line);
            }
        }

        static void ShowAllResults()
        {
            if (!File.Exists(resultFile))
            {
                Console.WriteLine("\n------- Результатов пока нет ---------- ");
                return;
            }

            Console.WriteLine("\n" + new string('=', 60));
            Console.WriteLine("| {0,-20} | {1,-10} | {2,-15} |", "ФИО", "Правильных ответов", "Диагноз");
            Console.WriteLine(new string('=', 60));

            string[] lines = File.ReadAllLines(resultFile);

            foreach (string line in lines)
            {
                string[] parts = line.Split('|');
                
                if (parts.Length == 3)
                {
                    string name = parts[0];
                    string correct = parts[1];
                    string diagnosis = parts[2];

                    Console.WriteLine("| {0,-20} | {1,-10} | {2,-15} |", name, correct, diagnosis);
                }
            }

            Console.WriteLine(new string('=', 60));    
        }


    }
}
